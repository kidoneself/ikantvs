# 独立 VPS 生产部署用。复制为 deploy/.env 并填真实值（.env 不进 git）。

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
DB_USERNAME=jyinshi
DB_PASSWORD=change-me-db

# JWT（生产必须改）：openssl rand -base64 48
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-bytes

# Cloudflare R2 海报
R2_ENABLED=true
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=jyinshi-posters
R2_PUBLIC_BASE=

# TMDB（可选，元数据刷新用）
TMDB_API_KEY=

# 前台 API 子域（构建 web 镜像时写入）
VITE_API_BASE=https://api.ikantvs.com/api

# CORS / 来源白名单（逗号分隔，须与浏览器页面 Origin 一致）
CORS_ENFORCE_ORIGIN=true
CORS_ALLOWED_ORIGINS=https://ikantvs.com,https://cf.ikantvs.com,http://103.24.216.84:8080,http://localhost:5173
