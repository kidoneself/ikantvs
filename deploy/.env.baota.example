# 宝塔部署：复制为 .env.baota 后改真实值
#   cp .env.baota.example .env.baota
#   ./deploy-baota.sh up
# 域名与 HTTPS 在宝塔面板配置，此处不填 SITE_DOMAIN / ACME_EMAIL

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
DB_USERNAME=jyinshi
DB_PASSWORD=change-me-db

# JWT（生产必须改）：openssl rand -base64 48
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-bytes

# 前台同源 API（宝塔把 /api 反代到 backend，勿改成外链）
VITE_API_BASE=/api

# 改成你的前台域名（宝塔站点 HTTPS 地址，多个用逗号分隔）
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CORS_ENFORCE_ORIGIN=true

# 迅雷 OAuth 回调（若用迅雷转存，改成你的域名）
# XUNLEI_REDIRECT_URI=https://example.com/api/auto-resource/xunlei/callback

# —— 本机采集 ——
# true=启动 pansou（约需额外 1G 内存）；内存紧可 false
ENABLE_PANSOU=true
PANSOU_BASE=http://pansou
INGEST_ENABLED=true
INGEST_PANSOU_ENABLED=true

# Cloudflare R2 海报（没有可关）
R2_ENABLED=false

# —— 夸克热榜灌库（开源默认）——
QUARK_RANKING_ENABLED=true

# TMDB（可选）
TMDB_API_KEY=

# 云端数据源（开源默认关）
JYINSHI_CLOUD_ENABLED=false
JYINSHI_CLOUD_BASE_URL=
JYINSHI_CLOUD_API_KEY=
