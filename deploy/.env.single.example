# 海外单机部署：复制为 .env.single 后改真实值
#   cp .env.single.example .env.single
#   ./deploy-single.sh init && ./deploy-single.sh up
#
# 推荐机器：2 核 4G+ 海外 VPS（香港 / 新加坡 / 美西等均可）
# 域名 A 记录指向该机；放行 80/443（建议同时放行 UDP 443）

# —— 必填 ——
SITE_DOMAIN=example.com
ACME_EMAIL=admin@example.com

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
DB_USERNAME=jyinshi
DB_PASSWORD=change-me-db

# JWT（生产必须改）：openssl rand -base64 48
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-bytes

# 前台同源 API（单域名勿改成 api. 子域）
VITE_API_BASE=/api

# CORS（脚本会按 SITE_DOMAIN 自动补全；也可手写覆盖）
# CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# 迅雷回调（脚本会按 SITE_DOMAIN 自动写成 https://域名/api/...）
# XUNLEI_REDIRECT_URI=https://example.com/api/auto-resource/xunlei/callback

CORS_ENFORCE_ORIGIN=true

# —— 云端数据源（对接运营方的「一份链接」；不填则用本机演示库）——
JYINSHI_CLOUD_ENABLED=false
JYINSHI_CLOUD_BASE_URL=https://api.example.com/api
JYINSHI_CLOUD_API_KEY=

# —— 本机采集（只要云端数据时可关，省约 1G 内存）——
# true=启动 pansou 容器；false=不启（纯壳 + 云端链接）
ENABLE_PANSOU=true
PANSOU_BASE=http://pansou
INGEST_ENABLED=true
INGEST_PANSOU_ENABLED=true

# Cloudflare R2 海报（没有可关）
R2_ENABLED=false
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=jyinshi-posters
R2_PUBLIC_BASE=

# TMDB（自建灌库时可选；纯云端模式可不填）
TMDB_API_KEY=
