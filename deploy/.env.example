# 与 docker-compose.yml 同目录保存为 .env
# 详细说明见 docs/部署.md

# ---------- 必改 ----------
MYSQL_ROOT_PASSWORD=change-me-root
DB_USERNAME=jyinshi
DB_PASSWORD=change-me-db
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-bytes

# 先用 IP：http://你的公网IP:3080 ；有域名再改 https://域名
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3080
CORS_ENFORCE_ORIGIN=true

# ---------- 业务开关 ----------
# APP_IMAGE=ghcr.io/kidoneself/ikantvs:latest

INGEST_ENABLED=true
INGEST_PANSOU_ENABLED=true
ENABLE_PANSOU=true

QUARK_RANKING_ENABLED=true
# 启动时分页翻榜；INTERVAL_MS 请求间隔；MAX_CREATES=0 不限制新建
QUARK_RANKING_HIT=50
QUARK_RANKING_MAX_PAGES=20
QUARK_RANKING_MAX_CREATES=0
QUARK_RANKING_INTERVAL_MS=500

R2_ENABLED=false
JYINSHI_CLOUD_ENABLED=false
# JYINSHI_CLOUD_BASE_URL=
# JYINSHI_CLOUD_API_KEY=

# Gying（可选）：日常请在后台「系统设置 → 资源采集」开关/填账号；下列仅首次种子
# INGEST_GYING_ENABLED=false
# INGEST_GYING_ACCOUNTS=user:pass
