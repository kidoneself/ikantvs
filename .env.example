# 复制为 .env 后按需填写（.env 不进 git）

# —— 本地库（演示模式，默认）——
DB_URL=jdbc:mysql://localhost:3306/jyinshi_next?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=jyinshi
DB_PASSWORD=jyinshi123
REDIS_HOST=localhost
JWT_SECRET=change-me-please-this-is-a-dev-only-secret-key-32bytes+

# —— 云端数据源（对接运营方的「一份链接」）——
# 打开后站点走上游片库/取链，而不是本地空库自己灌
JYINSHI_CLOUD_ENABLED=false
JYINSHI_CLOUD_BASE_URL=https://api.example.com/api
JYINSHI_CLOUD_API_KEY=

# —— 可选 ——
# R2_ENABLED=false
# Gying：也可在后台「系统设置 → 资源采集」填写；下列仅作首次种子
# INGEST_GYING_ENABLED=false
# INGEST_GYING_ACCOUNTS=user:pass

# 前台开发
# VITE_API_BASE=http://localhost:8888/api
